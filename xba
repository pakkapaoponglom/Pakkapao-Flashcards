<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>สำหรับคุณชัยวัฒน์ (พี่เอก) 💕</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Mitr:wght@300;400;500;600;700&family=Mali:wght@400;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            pinkPastel: {
              50: '#fff5f7',
              100: '#fde8ed',
              200: '#fbcfe8',
              300: '#f472b6',
              400: '#f43f5e',
            }
          },
          fontFamily: {
            mali: ['Mali', 'cursive'],
            mitr: ['Mitr', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: 'Mali', cursive;
      background: linear-gradient(135deg, #fff0f3 0%, #fde2e4 40%, #fbcfe8 100%);
      min-height: 100vh;
      touch-action: manipulation;
    }
    
    .glass-card {
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(12px);
      border: 3px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 15px 35px rgba(244, 114, 182, 0.2);
    }

    @keyframes bounce-gentle {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
    
    @keyframes pulse-heart {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.08); }
    }

    .animate-bounce-gentle {
      animation: bounce-gentle 2s infinite ease-in-out;
    }

    .animate-pulse-heart {
      animation: pulse-heart 1.5s infinite ease-in-out;
    }

    .spidey-badge {
      background: linear-gradient(135deg, #f87171 0%, #dc2626 100%);
      border: 2px solid #ffffff;
    }

    .icebear-badge {
      background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
      border: 2px solid #cbd5e1;
      color: #334155;
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-thumb { background: #f472b6; border-radius: 10px; }
  </style>
</head>
<body class="flex items-center justify-center p-3 sm:p-6 min-h-screen text-slate-800 select-none">

  <div id="bg-hearts" class="fixed inset-0 pointer-events-none z-0 overflow-hidden"></div>

  <main class="w-full max-w-md glass-card rounded-3xl p-5 sm:p-7 relative z-10 my-auto transition-all duration-300 min-h-[580px] flex flex-col justify-between overflow-hidden">
    
    <div class="flex justify-between items-center mb-3">
      <div class="icebear-badge text-xs px-3 py-1 rounded-full font-bold flex items-center gap-1.5 shadow-sm">
        <span class="text-base">🐻‍❄️</span> Ice Bear (หมีขาว)
      </div>
      <div class="spidey-badge text-white text-xs px-3 py-1 rounded-full font-bold flex items-center gap-1.5 shadow-sm">
        <span class="text-base">🕷️</span> Spiderman
      </div>
    </div>

    <div id="app-content" class="flex-1 flex flex-col justify-center items-center text-center">
    </div>

    <div class="mt-4 pt-3 border-t border-pink-100 text-center text-xs text-pink-400 flex items-center justify-center gap-1">
      <span>สร้างด้วยความรักสำหรับคุณชัยวัฒน์ (เอก)</span> 💕
    </div>
  </main>

  <script>
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    let audioCtx;
    
    function playTone(freq, type = 'sine', duration = 0.15) {
      try {
        if (!audioCtx) audioCtx = new AudioContext();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {}
    }

    function playClickSound() { playTone(587.33, 'sine', 0.1); }
    function playSuccessSound() { 
      playTone(523.25, 'triangle', 0.12);
      setTimeout(() => playTone(659.25, 'triangle', 0.12), 100);
      setTimeout(() => playTone(783.99, 'triangle', 0.2), 200);
    }
    function playErrorSound() {
      playTone(200, 'sawtooth', 0.2);
      setTimeout(() => playTone(150, 'sawtooth', 0.25), 180);
    }

    function initFloatingHearts() {
      const container = document.getElementById('bg-hearts');
      if (!container) return;
      const heartTypes = ['💖', '💕', '💗', '🌸', '🕷️', '🐻‍❄️'];
      for (let i = 0; i < 16; i++) {
        const span = document.createElement('span');
        span.innerText = heartTypes[Math.floor(Math.random() * heartTypes.length)];
        span.className = 'absolute text-xl opacity-25 transition-all pointer-events-none';
        span.style.left = Math.random() * 100 + '%';
        span.style.top = Math.random() * 100 + '%';
        span.style.fontSize = (16 + Math.random() * 20) + 'px';
        span.style.animation = `bounce-gentle ${2.5 + Math.random() * 3}s infinite ease-in-out ${Math.random() * 2}s`;
        container.appendChild(span);
      }
    }

    let state = {
      page: 'home',
      homeStep: 1,  
      pinInput: '',
      correctPin: '132022',
      pinError: false,
      loveAttempts: 0,
      oldAttempts: 0,
    };

    function setPage(pageName) {
      playClickSound();
      state.page = pageName;
      render();
    }

    function render() {
      const appContent = document.getElementById('app-content');
      if (!appContent) return;
      appContent.innerHTML = '';

      switch (state.page) {
        case 'home':
          renderHome(appContent);
          break;
        case 'password':
          renderPassword(appContent);
          break;
        case 'love':
          renderLove(appContent);
          break;
        case 'old':
          renderOld(appContent);
          break;
        case 'gift':
          renderGift(appContent);
          break;
        case 'final':
          renderFinal(appContent);
          break;
      }
    }

    function renderHome(appContent) {
      let contentHtml = '';
      if (state.homeStep === 1) {
        contentHtml = `
          <div class="animate-bounce-gentle mb-4 relative inline-block">
            <div class="w-24 h-24 bg-pink-50 rounded-full flex items-center justify-center text-5xl shadow-inner border-2 border-pink-200 mx-auto relative">
              ❓
              <span class="absolute -bottom-1 -right-2 text-3xl">🐻‍❄️</span>
            </div>
          </div>
          <h2 class="text-2xl font-bold text-pink-500 mb-2">คุณชัยวัฒน์ พร้อม</h2>
          <p class="text-xl font-semibold text-slate-700 mb-6">จะไปต่อหรือยัง??</p>
          <div class="flex gap-4 w-full max-w-xs justify-center">
            <button onclick="handleHomeNotReady()" class="flex-1 py-3 px-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-bold shadow-sm active:scale-95 transition">
              ไม่พร้อม
            </button>
            <button onclick="handleHomeReady()" class="flex-1 py-3 px-4 bg-pink-400 hover:bg-pink-500 text-white rounded-2xl font-bold shadow-md shadow-pink-200 active:scale-95 transition">
              พร้อมจ้า ✨
            </button>
          </div>
        `;
      } else if (state.homeStep === 2) {
        contentHtml = `
          <div class="mb-4 text-5xl animate-bounce-gentle">🥺</div>
          <h2 class="text-2xl font-bold text-pink-500 mb-2">ทำไมไม่พร้อม!!</h2>
          <p class="text-xl font-semibold text-slate-700 mb-6">ต้องพร้อมสิคะ 😤</p>
          <div class="flex gap-4 w-full max-w-xs justify-center">
            <button onclick="handleHomeNotReady()" class="flex-1 py-3 px-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-bold shadow-sm active:scale-95 transition">
              ไม่จ้า
            </button>
            <button onclick="handleHomeReady()" class="flex-1 py-3 px-4 bg-pink-400 hover:bg-pink-500 text-white rounded-2xl font-bold shadow-md shadow-pink-200 active:scale-95 transition">
              ok ok 👌
            </button>
          </div>
        `;
      } else if (state.homeStep === 3) {
        contentHtml = `
          <div class="mb-4 text-5xl animate-bounce-gentle">💥</div>
          <h2 class="text-2xl font-bold text-red-400 mb-6">บอกให้พร้อมไงโวยยย!! 😡</h2>
          <div class="w-full max-w-xs">
            <button onclick="handleHomeReady()" class="w-full py-4 bg-pink-400 hover:bg-pink-500 text-white text-xl rounded-2xl font-bold shadow-lg shadow-pink-200 active:scale-95 transition animate-pulse">
              พร้อมแล้วครับ! 💖
            </button>
          </div>
        `;
      }
      appContent.innerHTML = contentHtml;
    }

    function handleHomeNotReady() {
      playClickSound();
      if (state.homeStep < 3) state.homeStep++;
      render();
    }

    function handleHomeReady() {
      playSuccessSound();
      state.homeStep = 1;
      setPage('password');
    }

    function renderPassword(appContent) {
      if (state.pinError) {
        appContent.innerHTML = `
          <div class="animate-bounce-gentle text-6xl mb-3">😡😠</div>
          <h2 class="text-2xl font-bold text-red-400 mb-2">ใส่ผิดได้ไง!!</h2>
          <p class="text-slate-600 mb-6">จำรหัสผ่านเค้าไม่ได้หรอ งอนแล้วนะ!</p>
          <button onclick="resetFromError()" class="py-3 px-8 bg-pink-400 hover:bg-pink-500 text-white text-lg rounded-2xl font-bold shadow-md active:scale-95 transition">
            งอน 🥺 (ย้อนกลับไปหน้า Home)
          </button>
        `;
        return;
      }

      let dotsHtml = '';
      for (let i = 0; i < 6; i++) {
        const isFilled = i < state.pinInput.length;
        dotsHtml += `<div class="w-4 h-4 rounded-full border-2 border-pink-300 transition-all duration-200 ${isFilled ? 'bg-pink-400 scale-110' : 'bg-pink-50'}"></div>`;
      }

      const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', 'C', '0', '✓'];
      let keypadHtml = keys.map(k => {
        let btnClass = "bg-white text-slate-700 hover:bg-pink-50";
        if (k === '✓') btnClass = "bg-pink-400 text-white hover:bg-pink-500";
        if (k === 'C') btnClass = "bg-pink-50 text-pink-500 hover:bg-pink-100";

        return `
          <button onclick="handleKeypad('${k}')" class="h-12 sm:h-14 rounded-2xl font-bold text-xl shadow-sm border border-pink-100 active:scale-90 transition flex items-center justify-center ${btnClass}">
            ${k}
          </button>
        `;
      }).join('');

      appContent.innerHTML = `
        <div class="flex items-center gap-2 mb-1 text-pink-500">
          <span class="text-2xl">🔐</span>
          <h2 class="text-2xl font-bold">Password</h2>
        </div>
        <p class="text-xs text-pink-400 mb-4">(บอกใบ้: วันสำคัญของเรา)</p>
        <div class="flex justify-center gap-3 mb-6 bg-pink-50/70 p-3 rounded-2xl border border-pink-100 w-full max-w-xs">
          ${dotsHtml}
        </div>
        <div class="grid grid-cols-3 gap-3 w-full max-w-xs">
          ${keypadHtml}
        </div>
      `;
    }

    function handleKeypad(key) {
      playClickSound();
      if (key === 'C') {
        state.pinInput = '';
      } else if (key === '✓') {
        if (state.pinInput === state.correctPin) {
          playSuccessSound();
          state.pinInput = '';
          setPage('love');
        } else {
          playErrorSound();
          state.pinError = true;
        }
      } else {
        if (state.pinInput.length < 6) {
          state.pinInput += key;
          if (state.pinInput.length === 6) {
            setTimeout(() => {
              if (state.pinInput === state.correctPin) {
                playSuccessSound();
                state.pinInput = '';
                setPage('love');
              } else {
                playErrorSound();
                state.pinError = true;
                render();
              }
            }, 200);
          }
        }
      }
      render();
    }

    function resetFromError() {
      state.pinError = false;
      state.pinInput = '';
      setPage('home');
    }

    function renderLove(appContent) {
      const attempts = state.loveAttempts;
      if (attempts === 0) {
        appContent.innerHTML = `
          <div class="text-6xl mb-3 animate-pulse-heart">💖</div>
          <h2 class="text-2xl font-bold text-pink-500 mb-6">แฟนรักเค้า มั้ย?? 🥺</h2>
          <div class="flex gap-4 w-full max-w-xs justify-center items-center">
            <button onclick="handleLoveYes()" class="flex-1 py-3 px-4 bg-pink-400 hover:bg-pink-500 text-white rounded-2xl font-bold shadow-md shadow-pink-200 active:scale-95 transition">
              รัก 💕
            </button>
            <button onclick="handleLoveNo()" class="flex-1 py-3 px-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-bold active:scale-95 transition">
              ไม่รัก 💔
            </button>
          </div>
        `;
      } else if (attempts === 1) {
        appContent.innerHTML = `
          <div class="text-5xl mb-2">🤨</div>
          <h2 class="text-2xl font-bold text-pink-500 mb-1">ให้พูดอีกที!!</h2>
          <p class="text-sm text-slate-500 mb-6">คิดใหม่ดีๆ น้าาา 😤</p>
          <div class="flex gap-3 w-full max-w-xs justify-center items-center">
            <button onclick="handleLoveYes()" class="flex-[2] py-4 px-4 bg-pink-400 hover:bg-pink-500 text-white text-xl rounded-2xl font-bold shadow-md shadow-pink-200 active:scale-95 transition">
              รักมากๆ 💕💕
            </button>
            <button onclick="handleLoveNo()" class="flex-1 py-2 px-2 bg-slate-100 text-slate-500 text-xs rounded-xl font-bold active:scale-95 transition">
              ไม่รัก 💔
            </button>
          </div>
        `;
      } else {
        appContent.innerHTML = `
          <div class="text-6xl mb-2">😤💥</div>
          <h2 class="text-xl font-bold text-pink-500 mb-6">แล้วแต่เถอะ... งอนแล้วนะ!</h2>
          <div class="w-full max-w-xs">
            <button onclick="handleLoveGon()" class="w-full py-4 bg-pink-500 hover:bg-pink-600 text-white text-xl rounded-2xl font-bold shadow-lg shadow-pink-200 active:scale-95 transition animate-bounce">
              งอน 😤
            </button>
          </div>
        `;
      }
    }

    function handleLoveNo() {
      playClickSound();
      state.loveAttempts++;
      render();
    }

    function handleLoveYes() {
      playSuccessSound();
      state.loveAttempts = 0;
      const appContent = document.getElementById('app-content');
      appContent.innerHTML = `
        <div class="text-7xl mb-4 animate-bounce">🥰✨</div>
        <h2 class="text-3xl font-bold text-pink-500 mb-2">น่ารัก จังเลย💕</h2>
        <p class="text-slate-600">กดไปหน้าถัดไปกันเล้ยยย~</p>
      `;
      setTimeout(() => { setPage('old'); }, 1500);
    }

    function handleLoveGon() {
      playErrorSound();
      state.loveAttempts = 0;
      setPage('home');
    }

    function renderOld(appContent) {
      const step = state.oldAttempts;
      if (step === 0) {
        appContent.innerHTML = `
          <div class="text-6xl mb-3">👨‍🦳👓</div>
          <h2 class="text-2xl font-bold text-slate-800 mb-6">เอกเป็นคนแก่ ไหม??</h2>
          <div class="flex gap-4 w-full max-w-xs justify-center items-center">
            <button onclick="handleOldNo()" class="flex-1 py-3 px-4 bg-pink-100 hover:bg-pink-200 text-pink-600 rounded-2xl font-bold active:scale-95 transition">
              ไม่ 🙅‍♂️
            </button>
            <button onclick="handleOldYes()" class="flex-1 py-3 px-4 bg-pink-400 hover:bg-pink-500 text-white rounded-2xl font-bold shadow-md shadow-pink-200 active:scale-95 transition">
              แก่ 👴
            </button>
          </div>
        `;
      } else if (step === 1) {
        appContent.innerHTML = `
          <div class="text-5xl mb-2">😏</div>
          <h2 class="text-2xl font-bold text-pink-500 mb-4">ไม่เชื่อหรอก!!</h2>
          <div class="flex gap-3 w-full max-w-xs justify-center items-center">
            <button onclick="handleOldNo()" class="py-2 px-3 bg-slate-100 text-slate-500 text-xs rounded-xl font-bold active:scale-95 transition">
              ไม่แก่จริงๆ
            </button>
            <button onclick="handleOldYes()" class="flex-1 py-5 px-4 bg-pink-400 hover:bg-pink-500 text-white text-xl rounded-2xl font-bold shadow-lg active:scale-95 transition">
              แก่แล้ว! 👴
            </button>
          </div>
        `;
      } else if (step === 2) {
        appContent.innerHTML = `
          <div class="text-6xl mb-2">🙈</div>
          <h2 class="text-2xl font-bold text-pink-500 mb-4">โกหก!!</h2>
          <div class="w-full max-w-xs flex flex-col gap-3 items-center">
            <button onclick="handleOldYes()" class="w-full py-8 bg-pink-500 hover:bg-pink-600 text-white text-3xl rounded-3xl font-bold shadow-xl active:scale-95 transition">
              แก่แน่นอน!! 👴🔥
            </button>
            <button onclick="handleOldNo()" class="text-xs text-slate-400 py-1">
              ไม่
            </button>
          </div>
        `;
      } else {
        appContent.innerHTML = `
          <div class="text-6xl mb-2">👀👵</div>
          <h2 class="text-2xl font-bold text-pink-500 mb-4">ให้ตอบอีกที!!</h2>
          <div class="w-full max-w-xs flex gap-3">
            <button onclick="handleOldYes()" class="flex-1 py-10 bg-pink-400 hover:bg-pink-500 text-white text-4xl rounded-3xl font-bold shadow-xl active:scale-95 transition animate-pulse">
              แก่ 👴
            </button>
            <button onclick="handleOldYes()" class="flex-1 py-10 bg-pink-500 hover:bg-pink-600 text-white text-4xl rounded-3xl font-bold shadow-xl active:scale-95 transition animate-pulse">
              แก่ 👵
            </button>
          </div>
        `;
      }
    }

    function handleOldNo() {
      playClickSound();
      state.oldAttempts++;
      render();
    }

    function handleOldYes() {
      playSuccessSound();
      state.oldAttempts = 0;
      setPage('gift');
    }

    function renderGift(appContent) {
      appContent.innerHTML = `
        <div class="text-center mb-6 flex flex-col items-center">
          <h2 class="text-3xl font-bold text-pink-500 flex items-center justify-center gap-1">
            <span>มีไรจะให้</span>
            <span onclick="handleSecretHeartClick()" class="cursor-pointer inline-block hover:scale-125 transition-transform active:scale-90 text-pink-500 px-1 select-none">&hearts;</span>
          </h2>
          <p class="text-xs text-slate-400 mt-2">เลือกล่องของขวัญ 1 กล่องสิจ๊ะ!</p>
        </div>
        <div class="grid grid-cols-2 gap-8 w-full max-w-xs mb-4 px-2 my-auto">
          <button onclick="handleGiftSelect(1)" class="p-3 hover:scale-110 active:scale-90 transition duration-200 flex flex-col items-center justify-center focus:outline-none">
            <span class="text-6xl filter drop-shadow-sm">🎁</span>
          </button>
          <button onclick="handleGiftSelect(2)" class="p-3 hover:scale-110 active:scale-90 transition duration-200 flex flex-col items-center justify-center focus:outline-none">
            <span class="text-6xl filter drop-shadow-sm">🎁</span>
          </button>
          <button onclick="handleGiftSelect(3)" class="p-3 hover:scale-110 active:scale-90 transition duration-200 flex flex-col items-center justify-center focus:outline-none">
            <span class="text-6xl filter drop-shadow-sm">🎁</span>
          </button>
          <button onclick="handleGiftSelect(4)" class="p-3 hover:scale-110 active:scale-90 transition duration-200 flex flex-col items-center justify-center focus:outline-none">
            <span class="text-6xl filter drop-shadow-sm">🎁</span>
          </button>
        </div>
      `;
    }

    function handleSecretHeartClick() {
      playSuccessSound();
      triggerConfetti();
      setPage('final');
    }

    function handleGiftSelect(num) {
      playClickSound();
      if (num === 1) {
        alert("ว้าก! กล่องนี้ส่งกลับไปหน้า Password 😜");
        setPage('password');
      } else if (num === 2) {
        alert("โดนหลอก! กล่องนี้ส่งกลับไปหน้า 'รักไม่รัก' ใหม่ 💖");
        setPage('love');
      } else if (num === 3) {
        alert("ว้าาา! โดนเด้งกลับไปหน้า Home เลยยย 🏠");
        setPage('home');
      } else if (num === 4) {
        alert("ว้าก! กล่องนี้ส่งย้อนกลับไปหน้าคนแก่ (เริ่มถามใหม่) 👴");
        state.oldAttempts = 0;
        setPage('old');
      }
    }

    function renderFinal(appContent) {
      appContent.innerHTML = `
        <div class="flex flex-col items-center justify-center py-2 text-center">
          <div class="flex items-center justify-center gap-3 mb-4">
            <span class="text-5xl animate-bounce-gentle">🐻‍❄️</span>
            <span class="text-4xl animate-pulse">💖</span>
            <span class="text-5xl animate-bounce-gentle" style="animation-delay: 0.5s">🕷️</span>
          </div>
          <h2 class="text-2xl font-bold text-pink-500 mb-3 leading-snug">
            รักแฟนที่สุดในโลก 💗
          </h2>
          <div class="bg-pink-50/80 border border-pink-200 p-4 rounded-2xl my-2 max-w-xs shadow-inner">
            <p class="text-lg font-semibold text-slate-700 mb-1">
              แฟนสู้ๆ นะคะ เค้าเป็นกำลังใจให้เสมอ ✨
            </p>
          </div>
          <div class="relative my-4 animate-pulse-heart">
            <div class="w-32 h-32 bg-pink-400 rounded-full flex flex-col items-center justify-center text-white shadow-lg border-4 border-white mx-auto">
              <span class="text-2xl font-bold">💋</span>
              <span class="text-xl font-bold mt-1">จุ๊บ จุ๊บ</span>
            </div>
          </div>
          <button onclick="setPage('home')" class="mt-4 py-2 px-6 bg-pink-100 hover:bg-pink-200 text-pink-600 rounded-full font-bold text-sm transition shadow-sm">
            🔄 เริ่มต้นใหม่อีกรอบ
          </button>
        </div>
      `;
    }

    function triggerConfetti() {
      try {
        confetti({
          particleCount: 120,
          spread: 80,
          origin: { y: 0.6 }
        });
      } catch (e) {}
    }

    window.addEventListener('DOMContentLoaded', () => {
      render();
      initFloatingHearts();
    });
  </script>
</body>
